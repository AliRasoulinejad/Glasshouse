# Copy to deploy/.env and fill in. Never commit the filled-in file.

# The site's one origin, exactly as readers type it.
GLASSHOUSE_PUBLIC_URL=https://glasshouse.example
# What Caddy serves: the bare domain gets automatic HTTPS.
GLASSHOUSE_SITE_ADDRESS=glasshouse.example

# openssl rand -hex 32
GLASSHOUSE_SESSION_KEY=

# OAuth apps. Callback URLs: <public URL>/auth/github/callback and
# <public URL>/auth/google/callback. Leave a pair empty to disable it.
GLASSHOUSE_GITHUB_CLIENT_ID=
GLASSHOUSE_GITHUB_CLIENT_SECRET=
GLASSHOUSE_GOOGLE_CLIENT_ID=
GLASSHOUSE_GOOGLE_CLIENT_SECRET=

# Host ports (defaults 80/443).
#GLASSHOUSE_HTTP_PORT=80
#GLASSHOUSE_HTTPS_PORT=443
